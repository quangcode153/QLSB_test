# ==============================================================================
# SPORTCHAIN SERVER - CẤU HÌNH MẪU (ENVIRONMENT TEMPLATE)
# Copy file này thành .env trên máy chủ thực tế và nhập mật khẩu của bạn:
# cp .env.example .env
# ==============================================================================

# 1. Database Configuration (Yêu cầu mật khẩu có chữ hoa, chữ thường, số, ký tự đặc biệt)
DB_NAME=SportChainDb
DB_USER=sa
DB_PASSWORD=SportChain@2026!

# 2. JWT Authentication Secret Key (Tối thiểu 32 ký tự)
JWT_SECRET_KEY=SportChain_Ultra_Secret_Key_For_Jwt_Auth_2026_Secure_Token!
JWT_EXPIRE_HOURS=24
