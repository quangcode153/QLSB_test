@code {
    private string activeTab = "login";
    private LoginRequest loginRequest = new() { Email = "admin@sportchain.vn", Password = "123456" };
    private RegisterRequest registerRequest = new();
    private bool isAuthenticating = false;
    private string? authMessage = null;
    private bool authSuccess = false;

    protected override void OnInitialized()
    {
        ApiService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleLogin()
    {
        authMessage = null;
        if (string.IsNullOrWhiteSpace(loginRequest.Email) || string.IsNullOrWhiteSpace(loginRequest.Password))
        {
            authMessage = "Vui lòng nhập đầy đủ email và mật khẩu.";
            authSuccess = false;
            return;
        }

        isAuthenticating = true;
        var res = await ApiService.LoginAsync(loginRequest);
        isAuthenticating = false;

        if (res.Success && res.Data != null)
        {
            authSuccess = true;
            authMessage = "Đăng nhập thành công! Đang chuyển hướng...";
            RedirectAfterAuth(res.Data.Role);
        }
        else
        {
            authSuccess = false;
            authMessage = res.Message ?? "Đăng nhập thất bại. Vui lòng kiểm tra lại thông tin.";
        }
    }

    private async Task QuickLogin(string email)
    {
        loginRequest.Email = email;
        loginRequest.Password = "123456";
        await HandleLogin();
    }

    private async Task HandleRegister()
    {
        authMessage = null;
        if (string.IsNullOrWhiteSpace(registerRequest.FullName) || string.IsNullOrWhiteSpace(registerRequest.Email) || string.IsNullOrWhiteSpace(registerRequest.Password))
        {
            authMessage = "Vui lòng nhập đầy đủ họ tên, email và mật khẩu.";
            authSuccess = false;
            return;
        }

        isAuthenticating = true;
        var res = await ApiService.RegisterAsync(registerRequest);
        isAuthenticating = false;

        if (res.Success && res.Data != null)
        {
            authSuccess = true;
            authMessage = "Đăng ký thành công! Đang chuyển đến ma trận đặt sân...";
            RedirectAfterAuth(UserRole.Customer);
        }
        else
        {
            authSuccess = false;
            authMessage = res.Message ?? "Đăng ký thất bại. Email có thể đã tồn tại.";
        }
    }

    private void RedirectAfterAuth(UserRole role)
    {
        switch (role)
        {
            case UserRole.SuperAdmin:
                Navigation.NavigateTo("admin/dashboard");
                break;
            case UserRole.BranchManager:
                Navigation.NavigateTo("branch/dashboard");
                break;
            case UserRole.Receptionist:
                Navigation.NavigateTo("branch/pos");
                break;
            default:
                Navigation.NavigateTo("booking/matrix");
                break;
        }
    }

    private void NavigateToRoleWorkspace()
    {
        if (ApiService.CurrentUser != null)
        {
            RedirectAfterAuth(ApiService.CurrentUser.Role);
        }
    }

    private void HandleLogout()
    {
        ApiService.Logout();
        StateHasChanged();
    }

    private string GetRoleColorHex(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "#b91c1c",
            UserRole.BranchManager => "#1d4ed8",
            UserRole.Receptionist => "#b45309",
            _ => "#047857"
        };
    }

    private string GetRoleBadgeText(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "👑 SuperAdmin Toàn Hệ Thống",
            UserRole.BranchManager => "🏢 Quản Lý Chi Nhánh",
            UserRole.Receptionist => "🎧 Nhân Viên Lễ Tân & Thu Ngân",
            _ => "👤 Khách Hàng Thể Thao"
        };
    }

    private string GetRoleIcon(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "bi bi-shield-fill-check",
            UserRole.BranchManager => "bi bi-building-fill",
            UserRole.Receptionist => "bi bi-headset",
            _ => "bi bi-person-fill"
        };
    }
}
