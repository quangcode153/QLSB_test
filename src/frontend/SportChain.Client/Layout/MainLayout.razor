@inherits LayoutComponentBase
@inject SportChain.Client.Services.IApiService ApiService
@inject SportChain.Client.Services.ICourtRealtimeService RealtimeService
@inject NavigationManager Navigation
@using SportChain.Shared.Enums

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center" style="background: #ffffff; border-bottom: 1px solid #e2e8f0; height: 3.5rem;">
            <!-- Realtime Status Indicator -->
            <div class="d-flex align-items-center gap-2">
                @if (RealtimeService.IsConnected)
                {
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle d-flex align-items-center gap-1.5 py-1 px-2.5">
                        <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 0.5rem; height: 0.5rem;"></span>
                        <small class="fw-semibold">Realtime Active</small>
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-light text-secondary border d-flex align-items-center gap-1.5 py-1 px-2.5">
                        <span class="badge bg-secondary p-1 rounded-circle"></span>
                        <small>Realtime Standby</small>
                    </span>
                }

                @if (ApiService.CurrentUser != null)
                {
                    <span class="d-none d-md-inline-block">
                        @switch (ApiService.CurrentUser.Role)
                        {
                            case UserRole.SuperAdmin:
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                    <i class="bi bi-shield-fill-check me-1"></i> Quản Trị Hệ Thống
                                </span>
                                break;
                            case UserRole.BranchManager:
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                    <i class="bi bi-building-fill me-1"></i> Quản Lý Cơ Sở
                                </span>
                                break;
                            case UserRole.Receptionist:
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1">
                                    <i class="bi bi-headset me-1"></i> Lễ Tân & POS
                                </span>
                                break;
                            default:
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                    <i class="bi bi-person-fill me-1"></i> Khách Hàng
                                </span>
                                break;
                        }
                    </span>
                }
            </div>

            <!-- User Menu / Quick Account Switcher -->
            <div class="d-flex align-items-center gap-2">
                @if (ApiService.CurrentUser == null)
                {
                    <a href="#auth-section" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                        <i class="bi bi-person-circle me-1"></i> Đăng Nhập
                    </a>
                }

                <div class="dropdown">
                    <button class="btn btn-sm @(ApiService.CurrentUser != null ? "btn-outline-secondary" : "btn-warning") dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3" type="button" @onclick="ToggleUserMenu">
                        <i class="bi bi-person-circle fs-6"></i>
                        <span class="fw-medium">
                            @(ApiService.CurrentUser != null ? ApiService.CurrentUser.FullName : "Chuyển Quyền Nhanh (Demo)")
                        </span>
                    </button>
                    @if (showUserMenu)
                    {
                        <div class="dropdown-menu show dropdown-menu-end shadow-lg border-0 mt-2 p-2" style="display: block; position: absolute; right: 0; min-width: 270px; z-index: 1050;">
                            <h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                Chuyển nhanh môi trường (Demo)
                            </h6>
                            <button class="dropdown-item rounded py-2 d-flex align-items-center gap-2" @onclick='() => QuickLogin("admin@sportchain.vn", UserRole.SuperAdmin)'>
                                <i class="bi bi-shield-lock-fill text-danger fs-5"></i>
                                <div>
                                    <div class="fw-bold">Nguyễn Hoàng Admin</div>
                                    <small class="text-muted">Quản trị toàn chuỗi (SuperAdmin)</small>
                                </div>
                            </button>
                            <button class="dropdown-item rounded py-2 d-flex align-items-center gap-2" @onclick='() => QuickLogin("manager.caugiay@sportchain.vn", UserRole.BranchManager)'>
                                <i class="bi bi-building-fill text-primary fs-5"></i>
                                <div>
                                    <div class="fw-bold">Trần Văn Quản Lý</div>
                                    <small class="text-muted">Quản lý Cầu Giấy (BranchManager)</small>
                                </div>
                            </button>
                            <button class="dropdown-item rounded py-2 d-flex align-items-center gap-2" @onclick='() => QuickLogin("reception.caugiay@sportchain.vn", UserRole.Receptionist)'>
                                <i class="bi bi-headset text-warning fs-5"></i>
                                <div>
                                    <div class="fw-bold">Lê Thị Lễ Tân</div>
                                    <small class="text-muted">Lễ tân Cầu Giấy (Receptionist)</small>
                                </div>
                            </button>
                            <button class="dropdown-item rounded py-2 d-flex align-items-center gap-2" @onclick='() => QuickLogin("khachhang@gmail.com", UserRole.Customer)'>
                                <i class="bi bi-person-fill text-success fs-5"></i>
                                <div>
                                    <div class="fw-bold">Phạm Minh Khách</div>
                                    <small class="text-muted">Khách hàng đặt sân (Customer)</small>
                                </div>
                            </button>
                            @if (ApiService.CurrentUser != null)
                            {
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item text-danger rounded py-2" @onclick="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất về Trang Chủ
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <article class="content px-3 py-3">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center my-4 mx-auto" style="max-width: 600px;">
                        <i class="bi bi-exclamation-triangle-fill text-warning display-4 mb-2"></i>
                        <h4 class="fw-bold text-dark">Đã Xảy Ra Sự Cố Hiển Thị</h4>
                        <p class="text-muted small">Hệ thống đã tự động cô lập lỗi để bảo vệ ứng dụng. Vui lòng bấm thử lại hoặc tải lại trang.</p>
                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <button class="btn btn-success fw-bold rounded-pill px-4" @onclick="RecoverFromError">
                                <i class="bi bi-arrow-clockwise me-1"></i> Khôi Phục Giao Diện
                            </button>
                            <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-house-door me-1"></i> Về Trang Chủ
                            </a>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    private bool showUserMenu = false;
    private ErrorBoundary? errorBoundary;

    private void RecoverFromError()
    {
        errorBoundary?.Recover();
    }

    protected override async Task OnInitializedAsync()
    {
        ApiService.OnAuthStateChanged += StateHasChanged;
        // Bắt đầu lắng nghe WebSocket SignalR Hub
        await RealtimeService.StartAsync();
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task QuickLogin(string email, UserRole role)
    {
        showUserMenu = false;
        var res = await ApiService.LoginAsync(new SportChain.Shared.DTOs.Auth.LoginRequest
        {
            Email = email,
            Password = "123456"
        });

        if (res.Success)
        {
            StateHasChanged();
            switch (role)
            {
                case UserRole.SuperAdmin:
                    Navigation.NavigateTo("admin/dashboard");
                    break;
                case UserRole.BranchManager:
                    Navigation.NavigateTo("branch/dashboard");
                    break;
                case UserRole.Receptionist:
                    Navigation.NavigateTo("branch/pos");
                    break;
                default:
                    Navigation.NavigateTo("booking/matrix");
                    break;
            }
        }
    }

    private void Logout()
    {
        showUserMenu = false;
        ApiService.Logout();
        StateHasChanged();
        Navigation.NavigateTo("");
    }
}
